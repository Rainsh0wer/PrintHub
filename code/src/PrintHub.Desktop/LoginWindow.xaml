<Window x:Class="PrintHub.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintHub Admin" Height="580" Width="440"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}"
        FontFamily="{StaticResource AppFont}">
    <Border Background="White" CornerRadius="20" Margin="28" Padding="34" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="◒ PrintHub" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" />
            <TextBlock Text="Platform console" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,26" />

            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="Email" Style="{StaticResource Input}" Text="admin@printhub.vn" />

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,5" />
            <PasswordBox x:Name="Pwd" Padding="10,9" FontSize="14" BorderBrush="{StaticResource Border}" BorderThickness="1.4" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Err}" TextWrapping="Wrap" Margin="0,12,0,0" />

            <Button Content="Sign in" Style="{StaticResource BtnPrimary}" Margin="0,20,0,0" Click="SignIn_Click" />

            <Border Background="{StaticResource PrimarySoft}" CornerRadius="10" Padding="14" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="DEMO ADMIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                    <TextBlock Text="admin@printhub.vn  ·  Password123!" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
