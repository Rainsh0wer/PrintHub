<Window x:Class="PrintHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintHub — Platform Console" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Ink}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,10">
                    <TextBlock Text="◒ PrintHub" FontSize="21" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Platform console" FontSize="12" Foreground="#8E90B8" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,20">
                    <Border Background="#221F52" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="WhoName" Text="Admin" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Administrator" Foreground="#8E90B8" FontSize="11" Margin="0,1,0,0" />
                            <Button Content="Sign out" Style="{StaticResource NavBtn}" Margin="0,8,0,0" Padding="0" Foreground="#C9A2FF" Click="SignOut_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="16,14,16,0">
                    <Button Tag="approvals"  Content="Shop approvals"  Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                    <Button Tag="users"      Content="Users"           Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                    <Button Tag="catalog"    Content="Service catalog"  Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                    <Button Tag="vouchers"   Content="Vouchers"         Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                    <Button Tag="complaints" Content="Complaints"       Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                    <Button Tag="report"     Content="Platform report"  Style="{StaticResource NavBtn}" Margin="0,0,0,4" Click="Nav_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="Host" Grid.Column="1" />
    </Grid>
</Window>
