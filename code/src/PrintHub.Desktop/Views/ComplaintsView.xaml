<UserControl x:Class="PrintHub.Desktop.Views.ComplaintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Complaints" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Escalated disputes awaiting a final ruling (UC-41)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource BtnOutline}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DataGrid x:Name="Grid" Margin="1" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="46" />
                    <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="130" />
                    <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="1.2*" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="130" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Refund" Binding="{Binding RefundAmount, StringFormat={}{0:#,##0} đ}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Adjudicate selected" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="Uphold" Content="Uphold refund" VerticalAlignment="Center" IsChecked="True" />
                    <StackPanel Margin="18,0,0,0"><TextBlock Text="Refund amount (đ)" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="RefundAmount" Style="{StaticResource Input}" Width="140" /></StackPanel>
                    <StackPanel Margin="14,0,0,0"><TextBlock Text="Ruling note" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Ruling" Style="{StaticResource Input}" Width="360" /></StackPanel>
                    <Button Content="Submit ruling" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom" Margin="14,0,0,0" Click="Adjudicate_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
