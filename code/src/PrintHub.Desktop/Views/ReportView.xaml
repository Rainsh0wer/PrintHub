<UserControl x:Class="PrintHub.Desktop.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Platform report" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
            <TextBlock Text="Transactions, GMV and commission across the marketplace (UC-42)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel><TextBlock Text="From" FontSize="12" Foreground="{StaticResource Muted}" /><DatePicker x:Name="From" Width="150" /></StackPanel>
                <StackPanel Margin="14,0,0,0"><TextBlock Text="To" FontSize="12" Foreground="{StaticResource Muted}" /><DatePicker x:Name="To" Width="150" /></StackPanel>
                <Button Content="Run report" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom" Margin="14,0,0,0" Click="Run_Click" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Rows="2">
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiShops" Style="{StaticResource KpiValue}" Text="—" /><TextBlock Text="Total shops" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiActive" Style="{StaticResource KpiValue}" Text="—" /><TextBlock Text="Active shops" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiOrders" Style="{StaticResource KpiValue}" Text="—" /><TextBlock Text="Completed orders" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiGmv" Style="{StaticResource KpiValue}" Text="—" FontSize="20" /><TextBlock Text="Gross merchandise value" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiCommission" Style="{StaticResource KpiValue}" Text="—" FontSize="20" /><TextBlock Text="Commission earned" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock x:Name="KpiTop" Style="{StaticResource KpiValue}" Text="—" FontSize="18" /><TextBlock Text="Top shop by revenue" Style="{StaticResource KpiLabel}" /></StackPanel></Border>
        </UniformGrid>

        <TextBlock x:Name="Status" Grid.Row="3" Margin="2,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
    </Grid>
</UserControl>
