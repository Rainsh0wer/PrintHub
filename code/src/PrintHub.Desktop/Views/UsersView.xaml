<UserControl x:Class="PrintHub.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Users" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
            <TextBlock Text="Search accounts, lock or unlock access (UC-38)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="Query" Style="{StaticResource Input}" Width="300" VerticalContentAlignment="Center" ToolTip="Name, email or phone" />
                <ComboBox x:Name="RoleFilter" Width="150" Margin="12,0,0,0" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="All roles" />
                    <ComboBoxItem Content="Customer" />
                    <ComboBoxItem Content="ShopOwner" />
                    <ComboBoxItem Content="ShopStaff" />
                    <ComboBoxItem Content="Admin" />
                </ComboBox>
                <Button Content="Search" Style="{StaticResource BtnPrimary}" Margin="12,0,0,0" Click="Search_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DataGrid x:Name="Grid" Margin="1" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="46" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="1.4*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.6*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="Wallet" Binding="{Binding WalletBalance, StringFormat={}{0:#,##0} đ}" Width="110" />
                    <DataGridTextColumn Header="Joined" Binding="{Binding CreatedAt, StringFormat=d MMM yyyy}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Lock account" Style="{StaticResource BtnOutline}" Click="Lock_Click" />
                    <Button Content="Unlock account" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Unlock_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
