<UserControl x:Class="PrintHub.Desktop.Views.ServiceTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Service catalog" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Platform service types available to shops (UC-39)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource BtnOutline}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DataGrid x:Name="Grid" Margin="1" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="46" />
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding ServiceGroup}" Width="120" />
                    <DataGridTextColumn Header="Pricing" Binding="{Binding PricingModel}" Width="140" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="90" />
                    <DataGridCheckBoxColumn Header="File?" Binding="{Binding RequiresFile}" Width="60" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Add a service type" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Code" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Code" Style="{StaticResource Input}" Width="140" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Name" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="NameBox" Style="{StaticResource Input}" Width="200" /></StackPanel>
                    <StackPanel Margin="0,0,14,10">
                        <TextBlock Text="Group" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="GroupCombo" Width="150" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Document" /><ComboBoxItem Content="Finishing" /><ComboBoxItem Content="Fabrication" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,10">
                        <TextBlock Text="Pricing model" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="PricingCombo" Width="160" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="PerPage" /><ComboBoxItem Content="PerUnit" /><ComboBoxItem Content="MaterialAndTime" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Unit" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Unit" Style="{StaticResource Input}" Width="90" Text="page" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Order" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Order" Style="{StaticResource Input}" Width="70" Text="0" /></StackPanel>
                    <CheckBox x:Name="RequiresFile" Content="Requires file" VerticalAlignment="Bottom" Margin="0,0,14,16" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Create" Style="{StaticResource BtnPrimary}" Click="Create_Click" />
                    <Button Content="Deactivate selected" Style="{StaticResource BtnOutline}" Margin="10,0,0,0" Click="Deactivate_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
