<UserControl x:Class="PrintHub.Desktop.Views.VouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Vouchers" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Platform-funded promotional codes (UC-40)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource BtnOutline}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DataGrid x:Name="Grid" Margin="1" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding DiscountType}" Width="110" />
                    <DataGridTextColumn Header="Value" Binding="{Binding DiscountValue, StringFormat={}{0:#,##0.##}}" Width="90" />
                    <DataGridTextColumn Header="Min order" Binding="{Binding MinOrderAmount, StringFormat={}{0:#,##0} đ}" Width="110" />
                    <DataGridTextColumn Header="Used" Binding="{Binding UsedCount}" Width="60" />
                    <DataGridTextColumn Header="Limit" Binding="{Binding UsageLimit}" Width="60" />
                    <DataGridTextColumn Header="Valid to" Binding="{Binding ValidTo, StringFormat=d MMM yyyy}" Width="120" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Create a voucher" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Code" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Code" Style="{StaticResource Input}" Width="130" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Name" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="NameBox" Style="{StaticResource Input}" Width="180" /></StackPanel>
                    <StackPanel Margin="0,0,14,10">
                        <TextBlock Text="Type" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="TypeCombo" Width="140" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Percent" /><ComboBoxItem Content="FixedAmount" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Value" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="Value" Style="{StaticResource Input}" Width="90" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Min order" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="MinOrder" Style="{StaticResource Input}" Width="100" Text="0" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Max discount" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="MaxDiscount" Style="{StaticResource Input}" Width="100" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Usage limit" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="UsageLimit" Style="{StaticResource Input}" Width="90" Text="100" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Per user" FontSize="12" Foreground="{StaticResource Muted}" /><TextBox x:Name="PerUser" Style="{StaticResource Input}" Width="70" Text="1" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Valid from" FontSize="12" Foreground="{StaticResource Muted}" /><DatePicker x:Name="ValidFrom" Width="130" /></StackPanel>
                    <StackPanel Margin="0,0,14,10"><TextBlock Text="Valid to" FontSize="12" Foreground="{StaticResource Muted}" /><DatePicker x:Name="ValidTo" Width="130" /></StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Create" Style="{StaticResource BtnPrimary}" Click="Create_Click" />
                    <Button Content="Deactivate selected" Style="{StaticResource BtnOutline}" Margin="10,0,0,0" Click="Deactivate_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
