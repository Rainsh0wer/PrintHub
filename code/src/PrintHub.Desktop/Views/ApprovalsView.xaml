<UserControl x:Class="PrintHub.Desktop.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Shop approvals" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Applications awaiting platform review (UC-36)." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource BtnOutline}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DataGrid x:Name="Grid" Margin="1" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="46" />
                    <DataGridTextColumn Header="Shop" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" Width="1.2*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding OwnerEmail}" Width="1.4*" />
                    <DataGridTextColumn Header="District" Binding="{Binding District}" Width="*" />
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Applied" Binding="{Binding CreatedAt, StringFormat=d MMM yyyy}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Approve selected" Style="{StaticResource BtnPrimary}" Click="Approve_Click" />
                    <TextBox x:Name="Reason" Style="{StaticResource Input}" Width="320" Margin="14,0,0,0" VerticalContentAlignment="Center"
                             ToolTip="Reason (required to reject)" />
                    <Button Content="Reject" Style="{StaticResource BtnOutline}" Margin="10,0,0,0" Click="Reject_Click" />
                </StackPanel>
                <TextBlock x:Name="Status" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
