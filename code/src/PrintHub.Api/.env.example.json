{
  "_comment": "Copy this file to .env.json (gitignored) and fill in real secrets. .env.json is layered over appsettings.json at startup and overrides it. Leave a section blank/removed to keep that feature disabled (the app degrades gracefully).",

  "Jwt": {
    "Key": "replace-with-a-long-random-secret-at-least-32-chars"
  },

  "Cloudinary": {
    "CloudName": "your-cloud-name",
    "ApiKey": "your-api-key",
    "ApiSecret": "your-api-secret"
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "you@gmail.com",
    "Password": "your-gmail-app-password",
    "FromName": "PrintHub",
    "FromAddress": "you@gmail.com",
    "UseStartTls": true
  },

  "Authentication": {
    "Google": {
      "ClientId": "your-google-oauth-client-id.apps.googleusercontent.com",
      "ClientSecret": "your-google-oauth-client-secret"
    }
  }
}
