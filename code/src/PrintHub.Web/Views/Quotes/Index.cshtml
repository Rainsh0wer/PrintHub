@model PrintHub.Web.Models.QuoteVm
@{
    ViewData["Title"] = "Compare quotes";
    var cheapest = Model.Results?.OrderBy(r => r.Total).FirstOrDefault();
}

<div class="page-container" style="padding:24px 16px 60px">
    <div class="page-head">
        <h1>Compare quotes</h1>
        <span class="muted">Configure your job once — we price it across every eligible shop.</span>
    </div>

    @if (TempData["err"] != null) { <div class="alert-ph alert-err mb-3">@TempData["err"]</div> }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card-ph pad" style="position:sticky;top:90px">
                <form method="post">
                    @if (Model.ShopId is int sid)
                    {
                        <input type="hidden" name="ShopId" value="@sid" />
                        <div class="badge-ph mb-3">Quoting one shop only</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Service</label>
                        <select class="form-input" name="ServiceTypeId" id="svc">
                            @foreach (var s in Model.Services)
                            { <option value="@s.Id" data-model="@s.PricingModel" selected="@(s.Id == Model.ServiceTypeId)">@s.Name</option> }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-2"><label class="form-label">Quantity</label><input class="form-input" type="number" name="Quantity" min="1" value="@Model.Quantity" /></div>
                        <div class="col-6 mb-2" data-when="PerPage"><label class="form-label">Pages</label><input class="form-input" type="number" name="PageCount" min="1" value="@Model.PageCount" /></div>
                        <div class="col-6 mb-2" data-when="MaterialAndTime" hidden><label class="form-label">Grams</label><input class="form-input" type="number" name="EstimatedGrams" min="1" value="@Model.EstimatedGrams" /></div>
                    </div>
                    <div class="row g-2" data-when="PerPage">
                        <div class="col-6 mb-2"><label class="form-label">Colour</label><select class="form-input" name="ColorMode"><option value="0" selected="@(Model.ColorMode==0)">B&amp;W</option><option value="1" selected="@(Model.ColorMode==1)">Colour</option></select></div>
                        <div class="col-6 mb-2"><label class="form-label">Sides</label><select class="form-input" name="Sides"><option value="0" selected="@(Model.Sides==0)">Single</option><option value="1" selected="@(Model.Sides==1)">Double</option></select></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Sort by</label><select class="form-input" name="SortBy"><option value="0" selected="@(Model.SortBy==0)">Lowest price</option><option value="1" selected="@(Model.SortBy==1)">Fastest</option><option value="2" selected="@(Model.SortBy==2)">Best rated</option></select></div>
                    <button class="btn-ph btn-block btn-lg" type="submit">Compare quotes</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            @if (Model.Error != null) { <div class="alert-ph alert-err">@Model.Error</div> }
            else if (Model.Results is null) { <div class="empty-ph">Configure your job and hit <strong>Compare quotes</strong> to see prices from every eligible shop.</div> }
            else if (!Model.Results.Any()) { <div class="empty-ph">No shop can do this job right now. Try a different service or options.</div> }
            else
            {
                <div class="stack" style="--gap:14px">
                    @foreach (var q in Model.Results)
                    {
                        var best = cheapest != null && q.QuoteId == cheapest.QuoteId;
                        <div class="card-ph pad @(best ? "border-primary" : "")" style="@(best ? "border:2px solid var(--accent)" : "")">
                            <div class="between">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h3 class="fw-900" style="font-size:1.15rem">@q.ShopName</h3>
                                        @if (best) { <span class="badge-ph" style="background:var(--accent);color:#fff">Best price</span> }
                                        @if (q.IsIndicative) { <span class="status-badge st-warn">Indicative</span> }
                                    </div>
                                    <div class="muted mt-1" style="font-size:13.5px">@q.District · <span class="rating"><span class="stars">★</span> @q.Rating.ToString("0.0")</span> · ~@q.EstimatedMinutes min</div>
                                </div>
                                <div class="text-end">
                                    <div class="price-current" style="font-size:1.6rem">@q.Total.ToString("N0")<span class="cur"> ₫</span></div>
                                    <form method="post" asp-controller="Orders" asp-action="Place" class="mt-2">
                                        <input type="hidden" name="quoteId" value="@q.QuoteId" />
                                        <input type="hidden" name="serviceTypeId" value="@Model.ServiceTypeId" />
                                        <input type="hidden" name="quantity" value="@Model.Quantity" />
                                        <input type="hidden" name="pageCount" value="@Model.PageCount" />
                                        <input type="hidden" name="colorMode" value="@Model.ColorMode" />
                                        <input type="hidden" name="sides" value="@Model.Sides" />
                                        <input type="hidden" name="estimatedGrams" value="@Model.EstimatedGrams" />
                                        <button class="@(best ? "btn-ph" : "btn-outline-ph")" type="submit">Place order</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <p class="muted mt-3" style="font-size:12.5px">Orders are paid from your wallet. Prices lock to the quote you pick.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const svc = document.getElementById('svc');
        function sync(){ const m = svc.options[svc.selectedIndex].dataset.model; document.querySelectorAll('[data-when]').forEach(el => el.hidden = el.dataset.when !== m); }
        svc.addEventListener('change', sync); sync();
    </script>
}
