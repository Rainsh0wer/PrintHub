@using PrintHub.Web.Services
@{
    var role = Context.Session.GetString(SessionKeys.UserRole);
    var name = Context.Session.GetString(SessionKeys.UserName);
    var avatar = Context.Session.GetString(SessionKeys.UserAvatar);
    var isAdmin = role == "Admin";
    string A(string c) => ViewContext.RouteData.Values["controller"]?.ToString() == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Console") · PrintHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/printhub.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-ok="@TempData["ok"]" data-err="@TempData["err"]">
    <div class="console">
        <aside class="side">
            <a class="ph-logo" asp-controller="Home" asp-action="Index"><span class="mk">◒</span> PrintHub</a>
            @if (isAdmin)
            {
                <span class="side-label">Platform</span>
                <a class="@A("Admin")" asp-controller="Admin" asp-action="Approvals">Shop approvals</a>
                <a class="@A("AdminUsers")" asp-controller="AdminUsers" asp-action="Index">Users</a>
                <a class="@A("AdminCatalog")" asp-controller="AdminCatalog" asp-action="Index">Service types</a>
                <a class="@A("AdminVouchers")" asp-controller="AdminVouchers" asp-action="Index">Vouchers</a>
                <a class="@A("AdminComplaints")" asp-controller="AdminComplaints" asp-action="Index">Complaints</a>
                <a class="@A("AdminWallet")" asp-controller="AdminWallet" asp-action="Index">Top-ups</a>
                <a class="@A("AdminReports")" asp-controller="AdminReports" asp-action="Index">Reports</a>
            }
            else
            {
                <span class="side-label">Shop</span>
                <a class="@A("ShopConsole")" asp-controller="ShopConsole" asp-action="Orders">Order queue</a>
                <a class="@A("ShopRateCard")" asp-controller="ShopRateCard" asp-action="Index">Rate card</a>
                <a class="@A("ShopResources")" asp-controller="ShopResources" asp-action="Machines">Machines</a>
                <a asp-controller="ShopResources" asp-action="Materials">Materials</a>
                <a class="@A("ShopStaff")" asp-controller="ShopStaff" asp-action="Index">Staff</a>
                <a class="@A("ShopComplaints")" asp-controller="ShopComplaints" asp-action="Index">Complaints</a>
                <a class="@A("ShopReports")" asp-controller="ShopReports" asp-action="Index">Revenue</a>
            }
            <div class="spacer"></div>
            <a asp-controller="Shops" asp-action="Index">← Marketplace</a>
            <a asp-controller="Account" asp-action="Logout">Sign out</a>
        </aside>

        <div class="console-main">
            <header class="console-top">
                <strong>@(isAdmin ? "Platform console" : "Shop console")</strong>
                <span class="muted">/ @ViewData["Title"]</span>
                <div class="d-flex align-items-center gap-2" style="margin-left:auto">
                    <img class="ph-avatar" style="border-color:var(--border)" src="@avatar" alt="" onerror="this.style.display='none'" />
                    <span class="muted">@name</span>
                </div>
            </header>
            <div class="console-body">
                @RenderBody()
            </div>
        </div>
    </div>
    <div class="toast-wrap" id="toasts"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const b = document.body;
            function toast(msg, cls) {
                if (!msg) return;
                const t = document.createElement('div');
                t.className = 'toast ' + cls;
                t.innerHTML = '<i class="fas fa-' + (cls === 'ok' ? 'circle-check' : 'circle-exclamation') + '"></i><span>' + msg + '</span>';
                document.getElementById('toasts').appendChild(t);
                setTimeout(() => t.remove(), 4300);
            }
            toast(b.dataset.ok, 'ok'); toast(b.dataset.err, 'err');
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
