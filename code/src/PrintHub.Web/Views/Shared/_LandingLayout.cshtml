@using PrintHub.Web.Services
@{
    var signedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.AccessToken));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · PrintHub" : "PrintHub — Print & Fabrication Marketplace")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/printhub.css" asp-append-version="true" />
</head>
<body class="landing">
    <nav class="ld-nav">
        <div class="wrap bar">
            <a class="logo" style="color:#fff" asp-controller="Home" asp-action="Index"><span class="mark">◒</span> PrintHub</a>
            <div class="links hide-sm">
                <a href="#how">How it works</a>
                <a href="#services">Services</a>
                <a href="#reviews">Reviews</a>
                <a href="#shops">For shops</a>
            </div>
            @if (signedIn)
            {
                <a class="btn on-dark sm" asp-controller="Shops" asp-action="Index">Enter marketplace</a>
            }
            else
            {
                <a class="btn dark-outline sm hide-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="btn on-dark sm" asp-controller="Account" asp-action="Register">Get started</a>
            }
        </div>
    </nav>

    @RenderBody()

    <footer class="ld-foot">
        <div class="wrap between">
            <span class="logo" style="color:#fff;font-size:1rem"><span class="mark">◒</span> PrintHub</span>
            <span>Print &amp; fabrication marketplace · PRN232 · Built on ASP.NET Core</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
