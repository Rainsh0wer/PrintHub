@model List<PrintHub.Application.Features.Shops.Dtos.RateCardEntryDto>
@{
    ViewData["Title"] = "Rate card";
    Layout = "_ConsoleLayout";
}

@if (ViewBag.NoShop == true) { <div class="empty-ph">Your account isn't linked to a shop yet.</div>; return; }

<div class="between mb-3"><h1 class="fw-900" style="font-size:1.6rem">Rate card</h1><span class="muted">@Model.Count services</span></div>

@if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

<div class="card-ph" style="overflow:hidden">
    <table class="tbl">
        <thead><tr><th>Service</th><th>Group</th><th>Pricing</th><th class="text-end">Unit price</th><th class="text-end">Setup</th><th>Lead</th><th>Rules</th><th></th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="8" class="muted text-center" style="padding:44px">No services on the rate card yet.</td></tr> }
            @foreach (var e in Model)
            {
                <tr>
                    <td><strong>@e.ServiceTypeName</strong></td>
                    <td><span class="badge-ph">@e.ServiceGroup</span></td>
                    <td class="muted">@e.PricingModel</td>
                    <td class="text-end"><span class="price-current" style="font-size:15px">@e.UnitPrice.ToString("N0") ₫</span></td>
                    <td class="text-end muted">@(e.SetupFee > 0 ? e.SetupFee.ToString("N0") + " ₫" : "—")</td>
                    <td class="muted">@e.LeadTimeMinutes min</td>
                    <td>@(e.PriceRules.Any() ? $"{e.PriceRules.Count()} rule(s)" : "—")</td>
                    <td>@(e.IsActive ? "" : Html.Raw("<span class='status-badge st-err'>off</span>"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="muted mt-2" style="font-size:12.5px">Pricing rules (duplex, quantity tiers, materials) are configured per service.</p>
