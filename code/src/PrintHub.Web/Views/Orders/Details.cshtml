@model PrintHub.Application.Features.Orders.Dtos.OrderDetailDto
@{
    ViewData["Title"] = Model?.OrderCode ?? "Order";
    string Cls(string st) => st switch { "Completed" or "ReadyForPickup" or "OutForDelivery" => "st-ok", "Cancelled" or "Declined" or "ProductionFailed" => "st-err", "AwaitingAcceptance" => "st-warn", _ => "st-info" };
    var steps = new[] { "AwaitingAcceptance", "Accepted", "InProduction", "ReadyForPickup", "Completed" };
    int curIdx = Model is null ? -1 : Array.IndexOf(steps, Model.Status);
}

@if (Model is null)
{
    <div class="page-container" style="padding:64px 16px"><div class="alert-ph alert-err">@ViewBag.Error</div></div>
    return;
}

@section Styles {
<style>
    .steps { display: flex; gap: 6px; }
    .step { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; }
    .step .node { width: 36px; height: 36px; border-radius: 999px; display: grid; place-items: center; background: var(--ink-light); border: 1px solid var(--border); color: var(--text-muted); font-weight: 800; font-size: 14px; z-index: 1; }
    .step .l { font-size: 12px; color: var(--text-muted); text-align: center; }
    .step.done .node { background: var(--accent); border-color: var(--accent); color: #fff; }
    .step.done .l { color: var(--text-primary); font-weight: 700; }
    .step::after { content: ""; position: absolute; top: 18px; left: 50%; width: 100%; height: 3px; background: var(--border); z-index: 0; }
    .step:last-child::after { display: none; }
    .step.done::after { background: var(--accent); }
</style>
}

<div class="page-container" style="padding:24px 16px 60px">
    <a asp-action="Index" class="muted" style="font-size:13px">← My orders</a>
    <div class="page-head between" style="padding-top:8px">
        <div class="d-flex align-items-center gap-3"><h1>@Model.OrderCode</h1><span class="status-badge @Cls(Model.Status)">@Model.Status</span></div>
        <span class="muted">@Model.ShopName</span>
    </div>

    @if (Model.Status != "Cancelled" && Model.Status != "Declined")
    {
        <div class="card-ph pad steps mb-4">
            @for (int i = 0; i < steps.Length; i++)
            {
                var done = curIdx >= 0 && i <= curIdx;
                <div class="step @(done ? "done" : "")"><span class="node">@(done ? "✓" : (i + 1).ToString())</span><span class="l">@System.Text.RegularExpressions.Regex.Replace(steps[i], "(\\B[A-Z])", " $1")</span></div>
            }
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-ph pad mb-4">
                <h3 class="fw-900 mb-3" style="font-size:1.05rem">Items</h3>
                @foreach (var it in Model.Items)
                {
                    <div class="between" style="padding:.5rem 0;border-bottom:1px solid var(--border)">
                        <div><strong>@(it.SnapshotFileName ?? $"Service #{it.ServiceTypeId}")</strong>
                            <div class="muted" style="font-size:13px">Qty @it.Quantity@(it.PageCount.HasValue ? $" · {it.PageCount} pages" : "")@(it.ColorMode != null ? $" · {it.ColorMode}" : "")@(it.Sides != null ? $" · {it.Sides}" : "")</div>
                        </div>
                        <span class="price-current" style="font-size:15px">@it.LineTotal.ToString("N0") ₫</span>
                    </div>
                }
            </div>
            <div class="card-ph pad">
                <h3 class="fw-900 mb-3" style="font-size:1.05rem">History</h3>
                @foreach (var h in Model.History)
                {
                    <div class="d-flex gap-3 align-items-center" style="padding:.35rem 0">
                        <span class="muted" style="font-size:12.5px;min-width:118px">@h.CreatedAt.ToString("dd MMM HH:mm")</span>
                        <span style="font-size:14px">@h.ToStatus <span class="muted">— @h.Reason</span></span>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-ph pad mb-4">
                <h3 class="fw-900 mb-3" style="font-size:1.05rem">Summary</h3>
                <div class="between" style="padding:.3rem 0"><span class="muted">Subtotal</span><span>@Model.SubTotal.ToString("N0") ₫</span></div>
                @if (Model.DiscountAmount > 0) { <div class="between" style="padding:.3rem 0"><span class="muted">Discount</span><span style="color:var(--accent)">−@Model.DiscountAmount.ToString("N0") ₫</span></div> }
                <hr class="divider my-2" />
                <div class="between" style="padding:.3rem 0"><strong>Total paid</strong><span class="price-current">@Model.TotalAmount.ToString("N0") ₫</span></div>
                @if (Model.RefundedAmount is > 0) { <div class="between" style="padding:.3rem 0"><span class="muted">Refunded</span><span style="color:#1b5e20">@Model.RefundedAmount.Value.ToString("N0") ₫</span></div> }
            </div>

            @if (Model.Status is "AwaitingAcceptance" or "Accepted")
            {
                <form method="post" asp-action="Cancel" class="card-ph pad">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input class="form-input mb-2" name="reason" placeholder="Reason (optional)" />
                    <button class="btn-outline-ph btn-block" type="submit">Cancel order</button>
                </form>
            }
            @if (Model.Status is "ReadyForPickup" or "OutForDelivery")
            {
                <form method="post" asp-action="Confirm"><input type="hidden" name="id" value="@Model.Id" /><button class="btn-ph btn-block btn-lg" type="submit">Confirm receipt</button></form>
            }
            @if (Model.Status == "Completed")
            {
                <form method="post" asp-controller="Reviews" asp-action="Create" class="card-ph pad mb-3">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <h3 class="fw-900 mb-2" style="font-size:1.05rem">Leave a review</h3>
                    <label class="form-label">Rating</label>
                    <select class="form-input mb-2" name="rating"><option value="5">★★★★★</option><option value="4">★★★★</option><option value="3">★★★</option><option value="2">★★</option><option value="1">★</option></select>
                    <textarea class="form-input mb-2" name="comment" rows="2" placeholder="How did it go?"></textarea>
                    <button class="btn-ph btn-block" type="submit">Submit review</button>
                </form>
                <form method="post" asp-controller="Complaints" asp-action="Raise" class="card-ph pad">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <h3 class="fw-900 mb-2" style="font-size:1.05rem">Something wrong?</h3>
                    <select class="form-input mb-2" name="reason"><option value="0">Wrong output</option><option value="1">Missing pages</option><option value="2">Quality defect</option><option value="3">Late</option><option value="4">Other</option></select>
                    <textarea class="form-input mb-2" name="description" rows="2" placeholder="Describe the problem" required></textarea>
                    <button class="btn-outline-ph btn-block" type="submit">Raise a complaint</button>
                </form>
            }
        </div>
    </div>
</div>
