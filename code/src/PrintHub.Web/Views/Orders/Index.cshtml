@model PrintHub.Application.Common.Models.PagedResult<PrintHub.Application.Features.Orders.Dtos.OrderSummaryDto>
@{
    ViewData["Title"] = "My orders";
    string Cls(string st) => st switch { "Completed" or "ReadyForPickup" or "OutForDelivery" => "st-ok", "Cancelled" or "Declined" or "ProductionFailed" => "st-err", "AwaitingAcceptance" => "st-warn", _ => "st-info" };
}

<div class="page-container" style="padding:24px 16px 60px">
    <div class="page-head between">
        <div><h1>My orders</h1><span class="muted">@Model.TotalCount orders</span></div>
        <a class="btn-ph" asp-controller="Quotes" asp-action="Index">New order</a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty-ph">You have no orders yet. <a asp-controller="Quotes" asp-action="Index" class="fw-bold">Compare quotes</a> to place your first one.</div>
    }
    else
    {
        <div class="card-ph" style="overflow:hidden">
            <table class="tbl">
                <thead><tr><th>Order</th><th>Shop</th><th>Placed</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td><strong>@o.OrderCode</strong></td>
                            <td>@o.ShopName</td>
                            <td class="muted">@(o.PlacedAt?.ToString("dd MMM, HH:mm"))</td>
                            <td><span class="status-badge @Cls(o.Status)">@o.Status</span></td>
                            <td class="text-end"><span class="price-current" style="font-size:15px">@o.TotalAmount.ToString("N0") ₫</span></td>
                            <td class="text-end"><a class="btn-outline-ph btn-sm" asp-action="Details" asp-route-id="@o.Id">Track</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
