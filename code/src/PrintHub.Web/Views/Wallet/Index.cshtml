@model PrintHub.Application.Features.Wallet.Dtos.WalletLedgerDto
@{
    ViewData["Title"] = "Wallet";
    string TypeCls(string t) => t switch { "TopUp" or "Refund" => "st-ok", "Payment" => "st-err", _ => "st-info" };
}

<div class="page-container" style="padding:24px 16px 60px">
    <div class="page-head"><h1>Wallet</h1><span class="muted">Top up once, then order in a tap.</span></div>

    @if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-ph" style="overflow:hidden">
                <div class="pad"><h3 class="fw-900" style="font-size:1.05rem">Transactions</h3></div>
                <table class="tbl">
                    <thead><tr><th>Type</th><th>Reference</th><th>Date</th><th>Status</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                        @if (Model?.Transactions?.Items?.Any() != true)
                        {
                            <tr><td colspan="5" class="muted text-center" style="padding:40px">No transactions yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var t in Model.Transactions.Items)
                            {
                                <tr>
                                    <td><span class="status-badge @TypeCls(t.Type)">@t.Type</span></td>
                                    <td class="muted">@t.RefCode</td>
                                    <td class="muted">@t.CreatedAt.ToString("dd MMM, HH:mm")</td>
                                    <td>@t.Status</td>
                                    <td class="text-end fw-bold" style="color:@(t.Amount < 0 ? "var(--price)" : "#1b5e20")">@(t.Amount < 0 ? "" : "+")@t.Amount.ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-ph pad mb-4" style="background:linear-gradient(135deg,var(--accent),var(--accent-light));color:#fff">
                <span style="opacity:.85;font-size:13px;font-weight:600">Available balance</span>
                <div class="fw-900" style="font-size:2.6rem;margin-top:4px">@((Model?.Balance ?? 0).ToString("N0")) <span style="font-size:1.2rem;opacity:.8">₫</span></div>
            </div>
            <form method="post" asp-action="TopUp" class="card-ph pad">
                <h3 class="fw-900 mb-2" style="font-size:1.05rem">Top up</h3>
                <div class="d-flex gap-2 flex-wrap mb-2">
                    @foreach (var v in new[] { 50000, 100000, 200000, 500000 })
                    { <button type="button" class="sort-btn topq" data-v="@v">@v.ToString("N0")</button> }
                </div>
                <label class="form-label">Amount (₫)</label>
                <input class="form-input mb-2" type="number" name="amount" id="amt" min="10000" step="1000" value="100000" />
                <button class="btn-ph btn-block btn-lg" type="submit">Continue to transfer</button>
                <p class="muted mt-2 mb-0" style="font-size:12px">Balance is credited once the transfer is confirmed.</p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>document.querySelectorAll('.topq').forEach(b => b.addEventListener('click', () => document.getElementById('amt').value = b.dataset.v));</script>
}
