@model PrintHub.Application.Features.Wallet.Dtos.TopUpResponse
@{
    ViewData["Title"] = "Complete top-up";
}

<div class="wrap" style="max-width:560px;padding:48px 0 80px">
    <div style="text-align:center;margin-bottom:24px">
        <h1 style="font-size:1.8rem">Complete your top-up</h1>
        <p class="muted" style="margin-top:.3rem">Transfer <strong>@Model.Amount.ToString("N0") ₫</strong> and your wallet is credited once confirmed.</p>
    </div>

    <div class="card pad stack" style="--gap:1.2rem;align-items:center;text-align:center">
        <img src="@Model.QrImageUrl" alt="VietQR" style="width:220px;height:220px;border-radius:12px;border:1px solid var(--border)"
             onerror="this.style.display='none'" />
        <div class="stack" style="--gap:.6rem;width:100%">
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Bank</span><strong>@Model.BankName</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Account</span><strong>@Model.AccountNumber</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Name</span><strong>@Model.AccountName</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Amount</span><strong>@Model.Amount.ToString("N0") ₫</strong></div>
            <div class="between" style="padding:.4rem 0"><span class="muted">Transfer content</span><strong style="color:var(--primary)">@Model.TransferContent</strong></div>
        </div>
        <div class="alert info" style="width:100%;text-align:left">Use the exact transfer content <strong>@Model.RefCode</strong> so we can match your payment.</div>
        <a class="btn outline block" asp-action="Index">Back to wallet</a>
    </div>
</div>
