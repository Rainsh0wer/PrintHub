@model PrintHub.Application.Features.Wallet.Dtos.TopUpResponse
@{
    ViewData["Title"] = "Complete top-up";
}

<div class="page-container" style="max-width:560px;padding:44px 16px 70px">
    <div class="text-center mb-4">
        <h1 class="fw-900" style="font-size:1.7rem">Complete your top-up</h1>
        <p class="muted">Transfer <strong>@Model.Amount.ToString("N0") ₫</strong>; your wallet is credited once confirmed.</p>
    </div>

    <div class="card-ph pad text-center">
        <img src="@Model.QrImageUrl" alt="VietQR" style="width:220px;height:220px;border-radius:12px;border:1px solid var(--border)" onerror="this.style.display='none'" />
        <div class="mt-3 text-start">
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Bank</span><strong>@Model.BankName</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Account</span><strong>@Model.AccountNumber</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Name</span><strong>@Model.AccountName</strong></div>
            <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Amount</span><strong>@Model.Amount.ToString("N0") ₫</strong></div>
            <div class="between" style="padding:.4rem 0"><span class="muted">Transfer content</span><strong style="color:var(--accent)">@Model.TransferContent</strong></div>
        </div>
        <div class="alert-ph alert-info mt-3 text-start">Use the exact transfer content <strong>@Model.RefCode</strong> so we can match your payment.</div>
        <a class="btn-outline-ph btn-block mt-2" asp-action="Index">Back to wallet</a>
    </div>
</div>
