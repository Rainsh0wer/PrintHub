@model PrintHub.Application.Common.Models.PagedResult<PrintHub.Application.Features.Shops.Dtos.ShopSummaryDto>
@{
    ViewData["Title"] = "Shops";
    string q = ViewBag.Query ?? "";
    string? group = ViewBag.Group;
    string GCls(string g) => group == g ? "active" : "";
}

<div class="page-container" style="padding:24px 16px 60px">
    <div class="page-head between">
        <div>
            <h1>@(string.IsNullOrEmpty(q) ? "All shops" : $"Results for “{q}”")</h1>
            <span class="muted">@Model.TotalCount shops in Hà Nội</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <aside class="filter-sidebar">
                <div class="filter-title"><i class="fas fa-sliders"></i> Filters</div>
                <form method="get" class="filter-section">
                    <input type="hidden" name="group" value="@group" />
                    <div class="filter-section-title">Search</div>
                    <input class="form-input" name="q" value="@q" placeholder="Name or district…" />
                    <button class="btn-ph btn-block mt-2" type="submit">Apply</button>
                </form>
                <div class="filter-section">
                    <div class="filter-section-title">Service group</div>
                    <a class="@GCls("")" asp-action="Index" asp-route-q="@q"><i class="fas fa-layer-group"></i> All services</a>
                    <a class="@GCls("Document")" asp-action="Index" asp-route-q="@q" asp-route-group="Document"><i class="fas fa-file-lines"></i> Documents</a>
                    <a class="@GCls("Finishing")" asp-action="Index" asp-route-q="@q" asp-route-group="Finishing"><i class="fas fa-book"></i> Finishing</a>
                    <a class="@GCls("Fabrication")" asp-action="Index" asp-route-q="@q" asp-route-group="Fabrication"><i class="fas fa-cube"></i> Fabrication</a>
                </div>
                <div class="filter-section">
                    <div class="filter-section-title">Rating</div>
                    <label class="filter-check"><input type="checkbox" /> 4★ &amp; up</label>
                    <label class="filter-check"><input type="checkbox" /> 3★ &amp; up</label>
                </div>
            </aside>
        </div>

        <div class="col-lg-9">
            <div class="sort-bar">
                <span class="muted">Sort by</span>
                <a class="sort-btn active">Relevance</a>
                <a class="sort-btn">Top rated</a>
                <a class="sort-btn">Nearest</a>
                <span class="result-info ms-auto">@Model.TotalCount results</span>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-ph alert-err">@ViewBag.Error</div>
            }
            else if (!Model.Items.Any())
            {
                <div class="empty-ph">No shops matched. Try a different search or clear the filters.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var s in Model.Items)
                    {
                        <div class="col-6 col-md-4">
                            <a class="product-card" asp-action="Details" asp-route-id="@s.Id">
                                <div class="img-wrap">
                                    <img src="@s.CoverImageUrl" alt="@s.Name" loading="lazy" onerror="this.style.opacity=0" />
                                    <button class="wishlist-btn" onclick="event.preventDefault()"><i class="far fa-heart"></i></button>
                                    @if (s.RatingCount > 0 && s.RatingAverage >= 4.5) { <span class="card-badge">Top rated</span> }
                                </div>
                                <div class="body">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@s.LogoUrl" style="width:26px;height:26px;border-radius:50%" onerror="this.style.display='none'" />
                                        <span class="product-name">@s.Name</span>
                                    </div>
                                    <span class="muted" style="font-size:12.5px">@s.District@(string.IsNullOrEmpty(s.City) ? "" : ", " + s.City)</span>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @foreach (var g in s.ServiceGroups.Take(3)) { <span class="badge-ph">@g</span> }
                                    </div>
                                    <div class="card-meta" style="margin-top:auto">
                                        <span class="rating"><span class="stars">★</span> @s.RatingAverage.ToString("0.0") (@s.RatingCount)</span>
                                        <span class="price-current">@(s.MinUnitPrice.HasValue ? s.MinUnitPrice.Value.ToString("N0") : "—")<span class="cur"> ₫</span></span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
