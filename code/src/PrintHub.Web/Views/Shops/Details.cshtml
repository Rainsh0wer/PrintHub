@model PrintHub.Application.Features.Shops.Dtos.ShopDetailDto
@{
    ViewData["Title"] = Model?.Name ?? "Shop";
}

@if (Model is null)
{
    <div class="wrap" style="padding:64px 0"><div class="alert err">@ViewBag.Error</div></div>
    return;
}

<div class="shop-cover">
    <img src="@Model.CoverImageUrl" alt="" onerror="this.style.display='none'" />
    <div class="shop-cover-overlay"></div>
    <div class="wrap shop-cover-inner">
        <a class="btn outline sm" asp-action="Index" style="background:rgba(255,255,255,.85)">← All shops</a>
        <div class="between" style="align-items:flex-end;margin-top:auto">
            <div class="row" style="--gap:1rem;align-items:flex-end">
                <img class="shop-logo" src="@Model.LogoUrl" alt="" onerror="this.style.display='none'" />
                <div>
                    <h1 style="color:#fff;font-size:2.2rem">@Model.Name</h1>
                    <div class="row" style="--gap:1rem;align-items:center;color:#fff;margin-top:.4rem">
                        <span class="rating" style="color:#fff"><span class="stars">★</span> @Model.RatingAverage.ToString("0.0") <span style="opacity:.8">(@Model.RatingCount)</span></span>
                        <span style="opacity:.85">@Model.District, @Model.City</span>
                        <span class="badge ok">Open @Model.OpenTime.ToString("HH:mm")–@Model.CloseTime.ToString("HH:mm")</span>
                    </div>
                </div>
            </div>
            <a class="btn primary lg" asp-controller="Quotes" asp-action="Index" asp-route-shopId="@Model.Id">Get a quote</a>
        </div>
    </div>
</div>

<div class="wrap" style="padding:28px 0 64px">
    @if (Model.Gallery.Any())
    {
        <div class="gallery" style="margin-bottom:28px">
            @foreach (var g in Model.Gallery)
            {
                <figure class="gallery-item">
                    <img src="@g.Url" alt="@g.Caption" loading="lazy" onerror="this.closest('figure').style.display='none'" />
                    @if (!string.IsNullOrWhiteSpace(g.Caption))
                    {
                        <figcaption>@g.Caption</figcaption>
                    }
                </figure>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="muted" style="max-width:64ch;font-size:1.02rem;margin-bottom:28px">@Model.Description</p>
    }

    <div class="layout-2col" style="grid-template-columns:1.5fr .9fr">
        <div class="card pad">
            <h3 style="font-size:1.1rem;margin-bottom:14px">Rate card</h3>
            <table class="tbl">
                <thead><tr><th>Service</th><th>Group</th><th>Lead</th><th style="text-align:right">Unit price</th></tr></thead>
                <tbody>
                    @foreach (var svc in Model.Services)
                    {
                        <tr>
                            <td>
                                <div class="row" style="--gap:.6rem;align-items:center">
                                    <img src="@svc.IconUrl" style="width:30px;height:30px;border-radius:8px" alt="" onerror="this.style.display='none'" />
                                    <strong>@svc.ServiceTypeName</strong>
                                </div>
                            </td>
                            <td><span class="badge">@svc.ServiceGroup</span></td>
                            <td class="muted">@svc.LeadTimeMinutes min</td>
                            <td style="text-align:right"><span class="price" style="font-size:1rem">@svc.UnitPrice.ToString("N0")<span class="cur"> ₫</span></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="stack" style="--gap:20px">
            <div class="card pad">
                <h3 style="font-size:1.05rem;margin-bottom:14px">Equipment</h3>
                <div class="grid" style="grid-template-columns:1fr 1fr;--gap:12px">
                    @foreach (var m in Model.Machines)
                    {
                        var cls = m.Status == "Idle" ? "ok" : (m.Status == "Offline" ? "err" : "warn");
                        <div class="mach">
                            <img src="@m.PhotoUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                            <div class="pad" style="padding:10px 12px">
                                <strong style="font-size:.88rem;display:block">@m.Name</strong>
                                <span class="badge @cls" style="margin-top:4px"><span class="dot @cls"></span> @m.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card pad">
                <h3 style="font-size:1.05rem;margin-bottom:14px">Reviews</h3>
                @if (!Model.Reviews.Any())
                {
                    <p class="muted" style="margin:0;font-size:.9rem">No reviews yet.</p>
                }
                @foreach (var r in Model.Reviews.Take(4))
                {
                    <div class="stack" style="--gap:.5rem;margin-bottom:14px">
                        <div class="row" style="--gap:.6rem;align-items:center">
                            <img class="avatar" style="width:32px;height:32px" src="@r.CustomerAvatarUrl" alt="" onerror="this.style.display='none'" />
                            <div class="between" style="flex:1">
                                <strong style="font-size:.9rem">@r.CustomerName</strong>
                                <span class="rating"><span class="stars">★</span> @r.Rating</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <p class="muted" style="margin:0;font-size:.88rem">@r.Comment</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.PhotoUrls))
                        {
                            <div class="row" style="--gap:.4rem">
                                @foreach (var p in r.PhotoUrls.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <img src="@p" style="width:56px;height:44px;object-fit:cover;border-radius:8px" alt="" loading="lazy" onerror="this.style.display='none'" />
                                }
                            </div>
                        }
                    </div>
                    <hr class="divider" />
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .shop-cover { position: relative; height: 300px; background: #1a1a1e; overflow: hidden; }
        .shop-cover > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .shop-cover-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.15), rgba(0,0,0,.72)); }
        .shop-cover-inner { position: relative; height: 100%; display: flex; flex-direction: column; padding-top: 20px; padding-bottom: 24px; }
        .shop-logo { width: 76px; height: 76px; border-radius: 16px; border: 3px solid #fff; object-fit: cover; box-shadow: var(--sh-2); background:#fff; }
        .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px; }
        .gallery-item { margin: 0; position: relative; border-radius: var(--r); overflow: hidden; aspect-ratio: 4/3; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
        .gallery-item:hover img { transform: scale(1.05); }
        .gallery-item figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 8px 10px; font-size: .75rem; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.7)); }
        .mach { border: 1px solid var(--border); border-radius: var(--r-sm); overflow: hidden; }
        .mach > img { width: 100%; height: 90px; object-fit: cover; background: var(--surface-2); }
    </style>
}
