@model PrintHub.Application.Features.Shops.Dtos.ShopDetailDto
@{
    ViewData["Title"] = Model?.Name ?? "Shop";
}

@if (Model is null)
{
    <div class="page-container" style="padding:64px 16px"><div class="alert-ph alert-err">@ViewBag.Error</div></div>
    return;
}

@section Styles {
<style>
    .shop-cover { position: relative; height: 300px; background: var(--ink-dark); overflow: hidden; }
    .shop-cover > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .shop-cover .ov { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,22,51,.1), rgba(23,22,51,.78)); }
    .shop-cover .inner { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 24px 0; }
    .shop-logo { width: 78px; height: 78px; border-radius: 18px; border: 3px solid #fff; object-fit: cover; background: #fff; box-shadow: var(--shadow-md); }
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px; }
    .gallery figure { margin: 0; position: relative; border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 4/3; }
    .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .gallery figure:hover img { transform: scale(1.06); }
    .gallery figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 8px 10px; font-size: 12px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.72)); }
    .mach { border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
    .mach > img { width: 100%; height: 96px; object-fit: cover; background: var(--ink-light); }
</style>
}

<div class="shop-cover">
    <img src="@Model.CoverImageUrl" alt="" onerror="this.style.display='none'" />
    <div class="ov"></div>
    <div class="page-container inner">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div class="d-flex align-items-end gap-3">
                <img class="shop-logo" src="@Model.LogoUrl" onerror="this.style.display='none'" />
                <div class="text-white">
                    <h1 class="fw-900" style="font-size:2.2rem">@Model.Name</h1>
                    <div class="d-flex align-items-center gap-3 mt-1 flex-wrap">
                        <span class="rating" style="color:#fff"><span class="stars">★</span> @Model.RatingAverage.ToString("0.0") <span style="opacity:.8">(@Model.RatingCount)</span></span>
                        <span style="opacity:.85">@Model.District, @Model.City</span>
                        <span class="status-badge st-ok">Open @Model.OpenTime.ToString("HH:mm")–@Model.CloseTime.ToString("HH:mm")</span>
                    </div>
                </div>
            </div>
            <a class="btn-pop btn-ph btn-lg" asp-controller="Quotes" asp-action="Index" asp-route-shopId="@Model.Id">Get a quote</a>
        </div>
    </div>
</div>

<div class="page-container" style="padding:26px 16px 60px">
    @if (Model.Gallery.Any())
    {
        <div class="gallery mb-4">
            @foreach (var g in Model.Gallery)
            {
                <figure><img src="@g.Url" loading="lazy" onerror="this.closest('figure').style.display='none'" />@if (!string.IsNullOrWhiteSpace(g.Caption)) { <figcaption>@g.Caption</figcaption> }</figure>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="muted" style="max-width:64ch;font-size:1.02rem" class="mb-4">@Model.Description</p>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-ph pad">
                <h3 class="fw-900 mb-3" style="font-size:1.1rem">Rate card</h3>
                <table class="tbl">
                    <thead><tr><th>Service</th><th>Group</th><th>Lead</th><th class="text-end">Unit price</th></tr></thead>
                    <tbody>
                        @foreach (var svc in Model.Services)
                        {
                            <tr>
                                <td><div class="d-flex align-items-center gap-2"><img src="@svc.IconUrl" style="width:30px;height:30px;border-radius:8px" onerror="this.style.display='none'" /><strong>@svc.ServiceTypeName</strong></div></td>
                                <td><span class="badge-ph">@svc.ServiceGroup</span></td>
                                <td class="muted">@svc.LeadTimeMinutes min</td>
                                <td class="text-end"><span class="price-current" style="font-size:15px">@svc.UnitPrice.ToString("N0")<span class="cur"> ₫</span></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-ph pad mb-4">
                <h3 class="fw-900 mb-3" style="font-size:1.05rem">Equipment</h3>
                <div class="row g-2">
                    @foreach (var m in Model.Machines)
                    {
                        var cls = m.Status == "Idle" ? "st-ok" : (m.Status == "Offline" ? "st-err" : "st-warn");
                        <div class="col-6"><div class="mach"><img src="@m.PhotoUrl" loading="lazy" onerror="this.style.display='none'" /><div style="padding:8px 10px"><strong style="font-size:13px;display:block">@m.Name</strong><span class="status-badge @cls mt-1">@m.Status</span></div></div></div>
                    }
                </div>
            </div>

            <div class="card-ph pad">
                <h3 class="fw-900 mb-3" style="font-size:1.05rem">Reviews</h3>
                @if (!Model.Reviews.Any()) { <p class="muted mb-0" style="font-size:14px">No reviews yet.</p> }
                @foreach (var r in Model.Reviews.Take(4))
                {
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <img class="ph-avatar" style="width:32px;height:32px;border-color:var(--border)" src="@r.CustomerAvatarUrl" onerror="this.style.display='none'" />
                            <div class="between flex-grow-1"><strong style="font-size:14px">@r.CustomerName</strong><span class="rating"><span class="stars">★</span> @r.Rating</span></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment)) { <p class="muted mt-1 mb-0" style="font-size:13.5px">@r.Comment</p> }
                        @if (!string.IsNullOrWhiteSpace(r.PhotoUrls))
                        {
                            <div class="d-flex gap-1 mt-2">
                                @foreach (var p in r.PhotoUrls.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                { <img src="@p" style="width:56px;height:44px;object-fit:cover;border-radius:8px" loading="lazy" onerror="this.style.display='none'" /> }
                            </div>
                        }
                    </div>
                    <hr class="divider" />
                }
            </div>
        </div>
    </div>
</div>
