@model PrintHub.Application.Features.Shops.Dtos.ShopDetailDto
@{
    ViewData["Title"] = Model?.Name ?? "Shop";
}

@if (Model is null)
{
    <div class="page-container" style="padding:64px 16px"><div class="alert-ph alert-err">@ViewBag.Error</div></div>
    return;
}

@section Styles {
<style>
    .prof-head { display: grid; grid-template-columns: 1fr 1.08fr; gap: 48px; align-items: center; padding: 24px 0 44px; }
    .prof-avatar { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); box-shadow: var(--shadow-sm); background: #fff; }
    .prof-left h1 { font-size: clamp(2.1rem, 4vw, 3.1rem); font-weight: 900; letter-spacing: -.02em; margin: 18px 0 8px; }
    .prof-tag { color: var(--text-secondary); font-size: 1.05rem; max-width: 48ch; }
    .prof-stats { display: flex; gap: 28px; margin: 22px 0; color: var(--text-muted); font-size: 14px; }
    .prof-stats strong { color: var(--text-primary); }
    .prof-actions { display: flex; gap: 10px; }
    .prof-featured { position: relative; border-radius: 22px; overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 16/10; background: var(--ink-light); }
    .prof-featured img { width: 100%; height: 100%; object-fit: cover; }
    .prof-badge { position: absolute; top: 16px; left: 16px; background: #fff; color: var(--accent); font-weight: 800; padding: 6px 14px; border-radius: 999px; font-size: 13px; box-shadow: var(--shadow-sm); }
    .prof-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 28px; flex-wrap: wrap; }
    .prof-tabs a { padding: 12px 18px; font-weight: 700; color: var(--text-muted); border-bottom: 2px solid transparent; cursor: pointer; }
    .prof-tabs a.active { color: var(--text-primary); border-bottom-color: var(--accent); }
    .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .work-card { border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-sm); border: 1px solid var(--border); aspect-ratio: 4/3; position: relative; display: block; }
    .work-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .work-card:hover img { transform: scale(1.05); }
    .work-card figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 10px 12px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.72)); font-weight: 600; font-size: 14px; }
    @@media (max-width: 900px) { .prof-head { grid-template-columns: 1fr; } .works-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
}

<div class="page-container" style="padding-bottom:64px">
    <div class="prof-head">
        <div class="prof-left">
            <img class="prof-avatar" src="@Model.LogoUrl" onerror="this.style.display='none'" />
            <h1>@Model.Name</h1>
            <p class="prof-tag">@(string.IsNullOrWhiteSpace(Model.Description) ? $"Print & fabrication shop in {Model.District}, {Model.City}." : Model.Description)</p>
            <div class="prof-stats">
                <span><strong class="rating"><span class="stars">★</span> @Model.RatingAverage.ToString("0.0")</strong> rating</span>
                <span><strong>@Model.RatingCount</strong> reviews</span>
                <span><strong>@Model.Services.Count()</strong> services</span>
            </div>
            <div class="prof-actions">
                <a class="btn-ph btn-lg" asp-controller="Quotes" asp-action="Index" asp-route-shopId="@Model.Id"><i class="fas fa-scale-balanced"></i> Get a quote</a>
                <a class="btn-outline-ph btn-lg" onclick="showTab('rate')"><i class="far fa-rectangle-list"></i> Rate card</a>
                @if (Context.Session.GetString(PrintHub.Web.Services.SessionKeys.UserRole) == "Customer")
                {
                    <form method="post" asp-controller="Favourites" asp-action="Add">
                        <input type="hidden" name="shopId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Shops/Details/@Model.Id" />
                        <button class="btn-outline-ph btn-lg" type="submit"><i class="far fa-heart"></i> Save</button>
                    </form>
                }
            </div>
        </div>
        <div class="prof-featured">
            <img src="@Model.CoverImageUrl" onerror="this.style.display='none'" />
            <span class="prof-badge">Open @Model.OpenTime.ToString("HH:mm")–@Model.CloseTime.ToString("HH:mm")</span>
        </div>
    </div>

    <div class="prof-tabs">
        <a class="active" data-tab="work" onclick="showTab('work')">Work</a>
        <a data-tab="rate" onclick="showTab('rate')">Rate card</a>
        <a data-tab="reviews" onclick="showTab('reviews')">Reviews</a>
        <a data-tab="about" onclick="showTab('about')">About</a>
    </div>

    <div id="work" class="tab-pane">
        @if (Model.Gallery.Any())
        {
            <div class="works-grid">
                @foreach (var g in Model.Gallery)
                {
                    <figure class="work-card" style="margin:0"><img src="@g.Url" loading="lazy" onerror="this.closest('figure').style.display='none'" />@if (!string.IsNullOrWhiteSpace(g.Caption)) { <figcaption>@g.Caption</figcaption> }</figure>
                }
            </div>
        }
        else { <div class="empty-ph">This shop hasn't added portfolio work yet.</div> }
    </div>

    <div id="rate" class="tab-pane" hidden>
        <div class="card-ph" style="overflow:hidden">
            <table class="tbl">
                <thead><tr><th>Service</th><th>Group</th><th>Lead</th><th class="text-end">Unit price</th></tr></thead>
                <tbody>
                    @foreach (var svc in Model.Services)
                    {
                        <tr>
                            <td><div class="d-flex align-items-center gap-2"><img src="@svc.IconUrl" style="width:30px;height:30px;border-radius:8px" onerror="this.style.display='none'" /><strong>@svc.ServiceTypeName</strong></div></td>
                            <td><span class="badge-ph">@svc.ServiceGroup</span></td>
                            <td class="muted">@svc.LeadTimeMinutes min</td>
                            <td class="text-end"><span class="price-current" style="font-size:15px">@svc.UnitPrice.ToString("N0") ₫</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="reviews" class="tab-pane" hidden>
        <div class="row g-3" style="max-width:820px">
            @if (!Model.Reviews.Any()) { <div class="col-12"><div class="empty-ph">No reviews yet.</div></div> }
            @foreach (var r in Model.Reviews)
            {
                <div class="col-md-6">
                    <div class="card-ph pad h-100">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img class="ph-avatar" style="border-color:var(--border)" src="@r.CustomerAvatarUrl" onerror="this.style.display='none'" />
                            <div class="between flex-grow-1"><strong style="font-size:14px">@r.CustomerName</strong><span class="rating"><span class="stars">★</span> @r.Rating</span></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment)) { <p class="muted mb-0" style="font-size:14px">@r.Comment</p> }
                    </div>
                </div>
            }
        </div>
    </div>

    <div id="about" class="tab-pane" hidden>
        <div class="row g-4" style="max-width:820px">
            <div class="col-md-6">
                <div class="card-ph pad">
                    <h3 class="fw-900 mb-3" style="font-size:1.05rem">Shop details</h3>
                    <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Address</span><strong>@Model.AddressLine</strong></div>
                    <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Area</span><strong>@Model.District, @Model.City</strong></div>
                    <div class="between" style="padding:.4rem 0;border-bottom:1px solid var(--border)"><span class="muted">Phone</span><strong>@(Model.PhoneNumber ?? "—")</strong></div>
                    <div class="between" style="padding:.4rem 0"><span class="muted">Hours</span><strong>@Model.OpenTime.ToString("HH:mm")–@Model.CloseTime.ToString("HH:mm")</strong></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-ph pad">
                    <h3 class="fw-900 mb-3" style="font-size:1.05rem">Equipment</h3>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var m in Model.Machines)
                        {
                            var cls = m.Status == "Idle" ? "st-ok" : (m.Status == "Offline" ? "st-err" : "st-warn");
                            <span class="status-badge @cls">@m.Name</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(id) {
            document.querySelectorAll('.prof-tabs a').forEach(a => a.classList.toggle('active', a.dataset.tab === id));
            document.querySelectorAll('.tab-pane').forEach(p => p.hidden = p.id !== id);
        }
    </script>
}
