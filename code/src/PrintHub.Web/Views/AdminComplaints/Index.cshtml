@model PrintHub.Application.Common.Models.PagedResult<PrintHub.Application.Features.Complaints.Dtos.ComplaintDto>
@{
    ViewData["Title"] = "Complaints";
    Layout = "_ConsoleLayout";
}

<h1 class="fw-900 mb-3" style="font-size:1.6rem">Escalated complaints</h1>
@if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

@if (!Model.Items.Any())
{
    <div class="empty-ph">No complaints are awaiting adjudication.</div>
}
else
{
    <div class="stack" style="--gap:14px">
        @foreach (var c in Model.Items)
        {
            <div class="card-ph pad">
                <div class="between">
                    <div>
                        <div class="d-flex align-items-center gap-2"><strong>@c.OrderCode</strong><span class="status-badge st-warn">@c.Status</span><span class="badge-ph">@c.Reason</span></div>
                        <p class="muted mt-1 mb-0" style="font-size:14px">@c.Description</p>
                        <div class="muted mt-1" style="font-size:12.5px">Shop: @c.ShopName @(c.ShopResponse != null ? $"· Shop response: {c.ShopResponse}" : "")</div>
                    </div>
                </div>
                <form method="post" asp-action="Adjudicate" class="d-flex gap-2 align-items-end mt-3 flex-wrap">
                    <input type="hidden" name="id" value="@c.Id" />
                    <div><label class="form-label">Ruling</label>
                        <select class="form-input" name="upholdRefund" style="min-width:180px"><option value="true">Uphold — refund customer</option><option value="false">Reject complaint</option></select>
                    </div>
                    <div><label class="form-label">Refund (₫)</label><input class="form-input" type="number" name="refundAmount" value="@(c.RefundAmount ?? 0)" style="max-width:140px" /></div>
                    <div class="flex-grow-1"><label class="form-label">Note</label><input class="form-input" name="adminRuling" placeholder="Ruling note" /></div>
                    <button class="btn-ph" type="submit">Record ruling</button>
                </form>
            </div>
        }
    </div>
}
