@model PrintHub.Application.Features.Users.Dtos.ProfileDto
@{
    ViewData["Title"] = "Profile";
}

<div class="page-container" style="max-width:720px;padding:24px 16px 60px">
    <div class="page-head"><h1>My profile</h1></div>
    @if (TempData["err"] != null) { <div class="alert-ph alert-err mb-3">@TempData["err"]</div> }
    @if (TempData["ok"] != null) { <div class="alert-ph alert-ok mb-3">@TempData["ok"]</div> }
    @if (Model is null) { <div class="alert-ph alert-err">@ViewBag.Error</div>; return; }

    <div class="card-ph pad mb-4 d-flex align-items-center gap-3">
        <img class="ph-avatar" style="width:64px;height:64px;border-color:var(--border)" src="@Model.AvatarUrl" onerror="this.style.display='none'" />
        <div>
            <div class="fw-900" style="font-size:1.3rem">@Model.FullName</div>
            <div class="muted">@Model.Email · <span class="badge-ph">@Model.Role</span></div>
        </div>
        <div class="ms-auto text-end">
            <div class="muted" style="font-size:12.5px">Wallet balance</div>
            <div class="price-current" style="font-size:1.4rem">@Model.WalletBalance.ToString("N0") ₫</div>
        </div>
    </div>

    <form method="post" asp-action="Update" class="card-ph pad">
        <h3 class="fw-900 mb-3" style="font-size:1.05rem">Edit details</h3>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Full name</label><input class="form-input" name="fullName" value="@Model.FullName" required /></div>
            <div class="col-md-6"><label class="form-label">Phone</label><input class="form-input" name="phoneNumber" value="@Model.PhoneNumber" /></div>
            <div class="col-12"><label class="form-label">Default address</label><input class="form-input" name="defaultAddress" value="@Model.DefaultAddress" /></div>
            <div class="col-12"><label class="form-label">Avatar URL</label><input class="form-input" name="avatarUrl" value="@Model.AvatarUrl" /></div>
        </div>
        <button class="btn-ph mt-3" type="submit">Save changes</button>
    </form>
</div>
