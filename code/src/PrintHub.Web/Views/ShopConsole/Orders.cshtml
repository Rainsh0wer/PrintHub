@model PrintHub.Application.Common.Models.PagedResult<PrintHub.Application.Features.Orders.Dtos.OrderSummaryDto>
@{
    ViewData["Title"] = "Order queue";
    Layout = "_ConsoleLayout";
    string? cur = ViewBag.Status;
    string Cls(string st) => st switch { "Completed" or "ReadyForPickup" or "OutForDelivery" => "st-ok", "Cancelled" or "Declined" or "ProductionFailed" => "st-err", "AwaitingAcceptance" => "st-warn", _ => "st-info" };
    int Count(string s) => Model.Items.Count(o => o.Status == s);
    string FCls(string? s) => cur == s ? "active" : "";
}

@if (ViewBag.NoShop == true)
{
    <div class="empty-ph">Your account isn't linked to a shop yet. Apply to open a shop from the marketplace, or ask the owner to add you as staff.</div>
    return;
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat"><div class="k">New requests</div><div class="v" style="color:var(--price)">@Count("AwaitingAcceptance")</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="k">In production</div><div class="v" style="color:var(--accent)">@Count("InProduction")</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="k">Ready</div><div class="v" style="color:#1b5e20">@(Count("ReadyForPickup") + Count("OutForDelivery"))</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="k">Total shown</div><div class="v">@Model.TotalCount</div></div></div>
</div>

<div class="d-flex gap-2 flex-wrap mb-3">
    <a class="sort-btn @FCls(null)" asp-action="Orders">All</a>
    <a class="sort-btn @FCls("AwaitingAcceptance")" asp-action="Orders" asp-route-status="AwaitingAcceptance">New</a>
    <a class="sort-btn @FCls("Accepted")" asp-action="Orders" asp-route-status="Accepted">Accepted</a>
    <a class="sort-btn @FCls("InProduction")" asp-action="Orders" asp-route-status="InProduction">In production</a>
    <a class="sort-btn @FCls("ReadyForPickup")" asp-action="Orders" asp-route-status="ReadyForPickup">Ready</a>
</div>

<div class="card-ph" style="overflow:hidden">
    <table class="tbl">
        <thead><tr><th>Order</th><th>Placed</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Action</th></tr></thead>
        <tbody>
            @if (!Model.Items.Any()) { <tr><td colspan="5" class="muted text-center" style="padding:44px">No orders in this view.</td></tr> }
            @foreach (var o in Model.Items)
            {
                <tr>
                    <td><strong>@o.OrderCode</strong></td>
                    <td class="muted">@(o.PlacedAt?.ToString("dd MMM, HH:mm"))</td>
                    <td><span class="status-badge @Cls(o.Status)">@o.Status</span></td>
                    <td class="text-end"><span class="price-current" style="font-size:15px">@o.TotalAmount.ToString("N0") ₫</span></td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            @switch (o.Status)
                            {
                                case "AwaitingAcceptance":
                                    <form method="post" asp-action="Accept"><input type="hidden" name="id" value="@o.Id" /><button class="btn-ph btn-sm">Accept</button></form>
                                    <form method="post" asp-action="Decline"><input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="reason" value="0" /><button class="btn-outline-ph btn-sm">Decline</button></form>
                                    break;
                                case "Accepted":
                                    <form method="post" asp-action="Start"><input type="hidden" name="id" value="@o.Id" /><button class="btn-ph btn-sm">Start production</button></form>
                                    break;
                                case "InProduction":
                                    <form method="post" asp-action="Ready"><input type="hidden" name="id" value="@o.Id" /><button class="btn-ph btn-sm">Mark ready</button></form>
                                    break;
                                case "ReadyForPickup":
                                case "OutForDelivery":
                                    <form method="post" asp-action="Handover"><input type="hidden" name="id" value="@o.Id" /><button class="btn-ph btn-sm">Hand over</button></form>
                                    break;
                                default:
                                    <span class="muted">—</span>
                                    break;
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
