@model PrintHub.Application.Common.Models.PagedResult<PrintHub.Application.Features.Shops.Dtos.ShopSummaryDto>
@{
    ViewData["Title"] = "Print & Fabrication Marketplace";
}

@section Styles {
<style>
    .hero-banner { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--ink-dark); min-height: 460px; display: flex; align-items: center; margin: 22px 0 44px; }
    .hero-content { position: relative; z-index: 2; padding: 60px; max-width: 56%; color: #fff; }
    .hero-eyebrow { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: var(--pop); margin-bottom: 14px; }
    .hero-h1 { font-weight: 900; font-size: 4rem; line-height: 1.05; text-transform: uppercase; margin-bottom: 18px; }
    .hero-h1 span { color: var(--accent-light); }
    .hero-img { position: absolute; top: 0; right: 0; width: 52%; height: 100%; }
    .hero-img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to right, var(--ink-dark) 2%, transparent 55%); }
    .hero-img img { width: 100%; height: 100%; object-fit: cover; }

    .cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 56px; }
    .cat-item { text-decoration: none; text-align: center; }
    .cat-box { border-radius: var(--radius-lg); aspect-ratio: 4/3; overflow: hidden; margin-bottom: 12px; box-shadow: var(--shadow-sm); position: relative; }
    .cat-box img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
    .cat-item:hover .cat-box img { transform: scale(1.06); }
    .cat-box::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgba(23,22,51,.5)); }
    .cat-name { font-size: 15px; font-weight: 800; color: var(--ink-dark); text-transform: uppercase; }

    .section-title { font-size: 1.4rem; font-weight: 900; text-transform: uppercase; color: var(--ink-dark); }
    .featured-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }

    .philosophy { padding: 80px 0; text-align: center; max-width: 900px; margin: 0 auto; }
    .philosophy .tag { display: inline-block; background: var(--accent); color: #fff; padding: 6px 20px; border-radius: var(--radius-pill); font-size: .85rem; font-weight: 800; margin-bottom: 20px; }
    .philosophy h2 { font-size: 3rem; font-weight: 900; color: var(--ink-dark); line-height: 1.15; text-transform: uppercase; letter-spacing: -1px; }
    .philosophy h2 em { font-style: italic; color: var(--accent); }

    .how { background: var(--ink-dark); color: #fff; padding: 64px 44px; border-radius: var(--radius-lg); margin: 20px 0 60px; }
    .how-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius-md); padding: 26px; height: 100%; }
    .how-card .n { font-size: 2.4rem; font-weight: 900; color: var(--pop); }
    @@media (max-width: 900px) { .hero-content { max-width: 100%; } .hero-img { opacity: .25; } .cat-grid, .featured-grid { grid-template-columns: repeat(2, 1fr); } .hero-h1 { font-size: 2.6rem; } .philosophy h2 { font-size: 2rem; } }
</style>
}

<div class="page-container">
    <section class="hero-banner">
        <div class="hero-content">
            <div class="hero-eyebrow">Print &amp; fabrication marketplace</div>
            <h1 class="hero-h1">Every print job,<br><span>priced by every shop.</span></h1>
            <p style="font-size:1.1rem;opacity:.9;max-width:90%;margin-bottom:28px">
                Configure your job once — documents, binding, 3D printing, laser cutting — and compare real quotes across nearby shops. Order at the best price, pay from your wallet, and track it to pickup.
            </p>
            <div class="d-flex gap-3 flex-wrap">
                <a class="btn-pop btn-ph btn-lg" asp-controller="Quotes" asp-action="Index">Compare quotes <i class="fas fa-arrow-right"></i></a>
                <a class="btn-ph btn-lg" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25)" asp-controller="Shops" asp-action="Index">Browse shops</a>
            </div>
        </div>
        <div class="hero-img"><img src="https://picsum.photos/seed/printhub-press/900/700" alt="" onerror="this.style.display='none'" /></div>
    </section>

    <div class="cat-grid">
        @{
            var cats = new[] {
                ("Document", "Documents", "printhub-doc"),
                ("Finishing", "Finishing", "printhub-bind"),
                ("Fabrication", "3D printing", "printhub-3d"),
                ("Fabrication", "Laser cutting", "printhub-laser") };
        }
        @foreach (var c in cats)
        {
            <a class="cat-item" asp-controller="Shops" asp-action="Index" asp-route-group="@c.Item1">
                <div class="cat-box"><img src="https://picsum.photos/seed/@c.Item3/500/380" alt="" onerror="this.style.opacity=0" /></div>
                <div class="cat-name">@c.Item2</div>
            </a>
        }
    </div>

    <div class="between" style="margin-bottom:20px">
        <h2 class="section-title">Featured shops</h2>
        <a class="btn-outline-ph btn-sm" asp-controller="Shops" asp-action="Index">See all <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="featured-grid">
        @foreach (var s in Model.Items)
        {
            <a class="product-card" asp-controller="Shops" asp-action="Details" asp-route-id="@s.Id">
                <div class="img-wrap">
                    <img src="@s.CoverImageUrl" alt="@s.Name" loading="lazy" onerror="this.style.opacity=0" />
                    @if (s.RatingCount > 0 && s.RatingAverage >= 4.5) { <span class="card-badge">Top rated</span> }
                </div>
                <div class="body">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@s.LogoUrl" style="width:26px;height:26px;border-radius:50%" onerror="this.style.display='none'" />
                        <span class="product-name">@s.Name</span>
                    </div>
                    <span class="muted" style="font-size:12.5px">@s.District</span>
                    <div class="card-meta" style="margin-top:auto">
                        <span class="rating"><span class="stars">★</span> @s.RatingAverage.ToString("0.0")</span>
                        <span class="price-current">@(s.MaxUnitPrice.HasValue ? s.MaxUnitPrice.Value.ToString("N0") : "—")<span class="cur"> ₫</span></span>
                    </div>
                </div>
            </a>
        }
    </div>

    <div class="philosophy">
        <span class="tag">How PrintHub works</span>
        <h2>One spec. <em>Every shop.</em> The best price.</h2>
        <p class="muted" style="font-size:1.15rem;margin-top:20px">Stop calling shops one by one — configure your job once and let them compete for it.</p>
    </div>

    <div class="how">
        <div class="row g-4">
            @{
                var steps = new[] {
                    ("01", "Configure", "Pick a service, upload your file, set quantity and finishing — one spec covers every shop."),
                    ("02", "Compare", "See real quotes side by side, sorted by price, time, or rating, and choose your shop."),
                    ("03", "Collect", "Pay from your wallet and follow the order from accepted, to in production, to ready.") };
            }
            @foreach (var st in steps)
            {
                <div class="col-md-4">
                    <div class="how-card">
                        <div class="n">@st.Item1</div>
                        <h3 style="font-weight:800;text-transform:uppercase;margin:8px 0 10px">@st.Item2</h3>
                        <p style="color:rgba(255,255,255,.72);margin:0">@st.Item3</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Customer reviews ─────────────────────────────────────────── *@
    <div class="text-center" style="padding:20px 0 6px">
        <span class="tag" style="display:inline-block;background:var(--accent);color:#fff;padding:6px 20px;border-radius:var(--radius-pill);font-size:.85rem;font-weight:800">Loved by customers</span>
        <h2 class="fw-900 mt-3" style="font-size:2.2rem;text-transform:uppercase">What people say</h2>
    </div>
    <div class="row g-3 mb-2">
        @{
            var testimonials = new[] {
                ("Bound my thesis in an hour, right by the university gate. Cheapest of three shops.", "Minh Hoang", "Cầu Giấy", 5),
                ("Compared shops in seconds and saved 20% on 200 colour pages for our club.", "An Bui", "Đống Đa", 5),
                ("Laser-cut acrylic came out perfect. Loved tracking it from accepted to ready.", "Thao Do", "Hai Bà Trưng", 5),
                ("Wallet top-up + VietQR made paying painless. Order was ready before I arrived.", "Huy Tran", "Ba Đình", 4),
                ("The quote comparison is genuinely useful — no more calling five shops.", "Linh Pham", "Thanh Xuân", 5),
                ("Uploaded my file, picked the fastest shop, done. 3D print quality was great.", "Nam Vo", "Long Biên", 5) };
        }
        @foreach (var t in testimonials)
        {
            <div class="col-md-4">
                <div class="card-ph pad h-100">
                    <div class="stars mb-2" style="font-size:15px">@(new string('★', t.Item4))<span style="color:var(--border)">@(new string('★', 5 - t.Item4))</span></div>
                    <p style="font-size:14.5px;color:var(--text-secondary)">“@t.Item1”</p>
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <img class="ph-avatar" style="border-color:var(--border)" src="https://api.dicebear.com/9.x/initials/svg?seed=@t.Item2" />
                        <div><strong style="font-size:14px;display:block">@t.Item2</strong><span class="muted" style="font-size:12px">@t.Item3</span></div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── FAQ ─────────────────────────────────────────────────────── *@
    <div class="row g-4 align-items-start" style="padding:64px 0 20px">
        <div class="col-lg-4">
            <span class="fw-900" style="color:var(--accent);font-size:.8rem;letter-spacing:1px">FAQ</span>
            <h2 class="fw-900 mt-2" style="font-size:2rem;text-transform:uppercase">Frequently asked questions</h2>
            <p class="muted mt-2">Everything you need to know about ordering and paying on PrintHub.</p>
            <a class="btn-outline-ph mt-2" asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
        <div class="col-lg-8">
            <div class="accordion" id="faq">
                @{
                    var faqs = new[] {
                        ("How does comparing quotes work?", "Configure your job once — service, quantity, options — and PrintHub asks every eligible shop to price it. You see the quotes side by side and pick the shop you want, sorted by price, time, or rating."),
                        ("How do I pay?", "Every order is paid from your PrintHub wallet. Top up once via bank transfer (VietQR); your balance is credited when the transfer is confirmed, then ordering is a single tap."),
                        ("Can I cancel an order?", "Yes — before a shop starts production you can cancel and get a full refund back to your wallet. Once it's in production, the shop's terms apply."),
                        ("What can I get printed?", "Documents (B&W and colour, A4 to A1, plotting), finishing (spiral & thermal binding, lamination, business cards), 3D printing, and laser cutting & engraving."),
                        ("How do I open a shop on PrintHub?", "Sign up and apply to open a shop. Once approved, list your rate card and machines and start receiving matched jobs in your console.") };
                    var i = 0;
                }
                @foreach (var f in faqs)
                {
                    i++;
                    <div class="accordion-item" style="border:1px solid var(--border);border-radius:var(--radius-md);margin-bottom:10px;overflow:hidden">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(i == 1 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#faq@(i)" style="font-weight:700;box-shadow:none">@f.Item1</button>
                        </h2>
                        <div id="faq@(i)" class="accordion-collapse collapse @(i == 1 ? "show" : "")" data-bs-parent="#faq">
                            <div class="accordion-body muted" style="font-size:14.5px">@f.Item2</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Contact ─────────────────────────────────────────────────── *@
    <div class="how" style="background:var(--ink-dark)">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <span class="fw-900" style="color:var(--pop);font-size:.8rem;letter-spacing:1px">GET IN TOUCH</span>
                <h2 class="fw-900 mt-2" style="font-size:2.2rem;text-transform:uppercase">Contact us</h2>
                <p style="color:rgba(255,255,255,.72)">Questions about an order, or want to sell on PrintHub? We're here.</p>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    @foreach (var c in new[] {
                        ("fa-location-dot", "Address", "FPT University, Hòa Lạc, Hà Nội"),
                        ("fa-envelope", "Email", "support@printhub.vn"),
                        ("fa-phone", "Hotline", "1900 6868 (8:00–21:00)"),
                        ("fa-clock", "Support hours", "Every day, 8:00 – 21:00") })
                    {
                        <div class="col-sm-6">
                            <div class="how-card d-flex gap-3 align-items-start">
                                <i class="fas @c.Item1" style="color:var(--pop);font-size:1.3rem;margin-top:2px"></i>
                                <div><strong style="display:block">@c.Item2</strong><span style="color:rgba(255,255,255,.72);font-size:14px">@c.Item3</span></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Final CTA ───────────────────────────────────────────────── *@
    <div class="text-center" style="padding:60px 0 20px">
        <h2 class="fw-900" style="font-size:2.6rem;text-transform:uppercase">Ready to print smarter?</h2>
        <p class="muted mt-2" style="font-size:1.1rem">Compare quotes from every shop in seconds.</p>
        <a class="btn-pop btn-ph btn-lg mt-3" asp-controller="Quotes" asp-action="Index">Compare quotes now <i class="fas fa-arrow-right"></i></a>
    </div>
</div>
