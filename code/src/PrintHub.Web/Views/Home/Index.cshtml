@{
    ViewData["Title"] = "Print & Fabrication Marketplace";
    Layout = "_LandingLayout";
}

<section class="ld-hero">
    <div class="wrap">
        <span class="ld-pill">◒ Print &amp; fabrication marketplace</span>
        <h1 style="margin-top:1.2rem">Every print job,<br>priced by every shop.</h1>
        <p>Configure a job once — documents, binding, 3D printing, laser cutting — and PrintHub quotes it across every eligible shop. Order at the best price and track it to pickup.</p>
        <div class="cta">
            <a class="btn on-dark lg" asp-controller="Account" asp-action="Register">Get started</a>
            <a class="btn dark-outline lg" asp-controller="Shops" asp-action="Index">Browse shops</a>
        </div>
    </div>
</section>

<section class="ld-sec" style="padding-top:0">
    <div class="wrap grid" style="grid-template-columns:repeat(4,1fr);--gap:16px">
        @foreach (var f in new[] {
            ("⚡", "Compare in seconds", "One spec, live quotes from every shop."),
            ("◉", "Pay from your wallet", "Top up once, order in a tap."),
            ("◔", "Track to pickup", "Accepted → in production → ready."),
            ("★", "Rated by students", "Real reviews from real orders.") })
        {
            <div class="ld-feature">
                <div class="ic">@f.Item1</div>
                <h3 style="font-size:1.05rem">@f.Item2</h3>
                <p class="muted" style="margin:.4rem 0 0;font-size:.9rem">@f.Item3</p>
            </div>
        }
    </div>
</section>

<section class="ld-sec" id="how">
    <div class="wrap">
        <div style="text-align:center;max-width:44ch;margin:0 auto 44px">
            <span class="ld-pill">How it works</span>
            <h2 style="margin-top:1rem">Three steps from file to finished</h2>
        </div>
        <div class="grid" style="grid-template-columns:repeat(3,1fr);--gap:20px">
            @foreach (var s in new[] {
                ("Configure", "Pick a service, upload your file, set quantity and finishing — one spec covers every shop."),
                ("Compare", "See real quotes side by side, sorted by price, time, or rating, and choose your shop."),
                ("Collect", "Pay from your wallet and follow the order from accepted, to in production, to ready for pickup.") })
            {
                <div class="ld-card">
                    <h3>@s.Item1</h3>
                    <p class="muted" style="margin:.6rem 0 0">@s.Item2</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="ld-sec" id="services" style="padding-top:0">
    <div class="wrap">
        <div class="between" style="margin-bottom:28px">
            <h2>Print anything, make anything</h2>
            <a class="btn dark-outline" asp-controller="Shops" asp-action="Index">See all shops</a>
        </div>
        <div class="grid" style="grid-template-columns:repeat(4,1fr);--gap:16px">
            @foreach (var svc in new[] {
                ("Documents", "B&W & colour, A4–A1, plotting"),
                ("Finishing", "Spiral & thermal binding, lamination"),
                ("3D printing", "FDM priced by material & time"),
                ("Laser", "Cutting & engraving") })
            {
                <div class="ld-feature">
                    <div class="ic">◒</div>
                    <h3 style="font-size:1.05rem">@svc.Item1</h3>
                    <p class="muted" style="margin:.4rem 0 0;font-size:.9rem">@svc.Item2</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="ld-sec" id="reviews">
    <div class="wrap">
        <div style="text-align:center;max-width:42ch;margin:0 auto 40px">
            <span class="ld-pill">Reviews</span>
            <h2 style="margin-top:1rem">Trusted by people who print a lot</h2>
        </div>
        <div class="grid" style="grid-template-columns:repeat(3,1fr);--gap:16px">
            @foreach (var r in new[] {
                ("Fast and cheap, right by the gate. Bound my thesis in an hour.", "Minh H.", "Cầu Giấy"),
                ("Compared three shops and saved 20% on 200 colour pages.", "An B.", "Đống Đa"),
                ("Laser-cut acrylic came out perfect. Great communication.", "Thao D.", "Hai Bà Trưng") })
            {
                <div class="ld-card">
                    <div class="stars" style="font-size:1rem">★★★★★</div>
                    <p style="margin:.8rem 0 1rem;color:var(--d-text)">“@r.Item1”</p>
                    <div class="row" style="--gap:.6rem;align-items:center">
                        <img class="avatar" src="https://api.dicebear.com/9.x/initials/svg?seed=@r.Item2" alt="" />
                        <div><strong style="display:block;font-size:.9rem">@r.Item2</strong><span class="muted" style="font-size:.8rem">@r.Item3</span></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="ld-sec" id="shops" style="padding-top:0">
    <div class="wrap">
        <div class="ld-card" style="text-align:center;padding:56px 24px;background:linear-gradient(180deg,#141417,#0f0f12)">
            <span class="ld-pill">For shops</span>
            <h2 style="margin:1rem 0 .6rem;font-size:clamp(1.8rem,4vw,2.6rem)">Run a print or fab shop? Sell on PrintHub.</h2>
            <p class="muted" style="max-width:50ch;margin:0 auto 1.8rem">List your rate card, get matched to nearby jobs, and manage your order queue from one console.</p>
            <a class="btn on-dark lg" asp-controller="Account" asp-action="Register">Become a seller</a>
        </div>
    </div>
</section>
