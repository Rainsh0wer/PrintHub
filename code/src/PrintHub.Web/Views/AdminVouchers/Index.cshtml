@model List<PrintHub.Application.Features.Vouchers.Dtos.VoucherAdminDto>
@{
    ViewData["Title"] = "Vouchers";
    Layout = "_ConsoleLayout";
}

<h1 class="fw-900 mb-3" style="font-size:1.6rem">Vouchers</h1>
@if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

<div class="row g-4">
    <div class="col-lg-8">
        <div class="stack" style="--gap:12px">
            @foreach (var v in Model)
            {
                <div class="card-ph pad" style="@(v.IsActive ? "" : "opacity:.7")">
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <strong style="font-family:monospace">@v.Code</strong>
                        <span class="muted">@v.Name</span>
                        <span class="badge-ph">@(v.DiscountType == "Percent" ? $"{v.DiscountValue:0}%" : $"{v.DiscountValue:N0} ₫")</span>
                        <span class="muted" style="font-size:12.5px">used @v.UsedCount / @v.UsageLimit</span>
                        <span class="status-badge @(v.IsActive ? "st-ok" : "st-err")">@(v.IsActive ? "Active" : "Off")</span>
                    </div>
                    <form method="post" asp-action="Update" class="row g-2 align-items-end">
                        <input type="hidden" name="id" value="@v.Id" />
                        <div class="col-md-3">
                            <label class="form-label" style="font-size:12px">Name</label>
                            <input class="form-input" name="name" value="@v.Name" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" style="font-size:12px">Value</label>
                            <input class="form-input" type="number" name="discountValue" step="0.01" min="0" value="@v.DiscountValue" required />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" style="font-size:12px">Min order (₫)</label>
                            <input class="form-input" type="number" name="minOrderAmount" step="1000" min="0" value="@v.MinOrderAmount" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" style="font-size:12px">Max discount (₫)</label>
                            <input class="form-input" type="number" name="maxDiscountAmount" step="1000" min="0" value="@v.MaxDiscountAmount" />
                        </div>
                        <div class="col-6 col-md-1">
                            <label class="form-label" style="font-size:12px">Limit</label>
                            <input class="form-input" type="number" name="usageLimit" min="0" value="@v.UsageLimit" />
                        </div>
                        <div class="col-6 col-md-1">
                            <label class="form-label" style="font-size:12px">Per user</label>
                            <input class="form-input" type="number" name="perUserLimit" min="1" value="@v.PerUserLimit" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" style="font-size:12px">Valid from</label>
                            <input class="form-input" type="date" name="validFrom" value="@v.ValidFrom.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" style="font-size:12px">Valid to</label>
                            <input class="form-input" type="date" name="validTo" value="@v.ValidTo.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6 col-md-2 pb-2">
                            <label style="font-size:12.5px"><input type="checkbox" name="isActive" value="true" checked="@v.IsActive" /> Active</label>
                        </div>
                        <div class="col-md-2">
                            <button class="btn-ph btn-block" type="submit">Save</button>
                        </div>
                    </form>
                    @if (v.IsActive)
                    {
                        <form method="post" asp-action="Deactivate" class="mt-2">
                            <input type="hidden" name="id" value="@v.Id" />
                            <button class="btn-outline-ph" type="submit" style="font-size:12.5px;padding:5px 12px"
                                    onclick="return confirm('Deactivate @v.Code? Customers can no longer apply it.')">Deactivate</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <form method="post" asp-action="Create" class="card-ph pad">
            <h3 class="fw-900 mb-2" style="font-size:1.05rem">Create voucher</h3>
            <label class="form-label">Code</label><input class="form-input mb-2" name="code" required placeholder="SALE50K" />
            <label class="form-label">Name</label><input class="form-input mb-2" name="name" />
            <label class="form-label">Type</label>
            <select class="form-input mb-2" name="discountType"><option value="0">Percent</option><option value="1">Fixed amount</option></select>
            <div class="row g-2">
                <div class="col-6"><label class="form-label">Value</label><input class="form-input mb-2" type="number" name="discountValue" value="10" required /></div>
                <div class="col-6"><label class="form-label">Min order</label><input class="form-input mb-2" type="number" name="minOrderAmount" value="50000" /></div>
            </div>
            <div class="row g-2">
                <div class="col-6"><label class="form-label">Usage limit</label><input class="form-input mb-2" type="number" name="usageLimit" value="100" /></div>
                <div class="col-6"><label class="form-label">Per user</label><input class="form-input mb-2" type="number" name="perUserLimit" value="1" /></div>
            </div>
            <div class="row g-2">
                <div class="col-6"><label class="form-label">Valid from</label><input class="form-input mb-3" type="date" name="validFrom" value="2026-07-01" /></div>
                <div class="col-6"><label class="form-label">Valid to</label><input class="form-input mb-3" type="date" name="validTo" value="2026-12-31" /></div>
            </div>
            <button class="btn-ph btn-block" type="submit">Create</button>
        </form>
    </div>
</div>
