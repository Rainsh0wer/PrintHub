@{
    ViewData["Title"] = "Sign in";
}

<div class="wrap" style="max-width:440px;padding-top:56px;padding-bottom:80px">
    <div style="text-align:center;margin-bottom:24px">
        <h1 style="font-size:1.9rem">Welcome back</h1>
        <p class="muted" style="margin-top:.3rem">Sign in to your PrintHub account.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert err" style="margin-bottom:16px">@ViewBag.Error</div>
    }

    <div class="card pad">
        <form method="post" class="stack" style="--gap:1rem">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-row">
                <label class="lbl" for="email">Email</label>
                <input class="input" id="email" name="email" type="email" required autofocus value="@ViewBag.Email" placeholder="you@example.com" />
            </div>
            <div class="form-row">
                <label class="lbl" for="password">Password</label>
                <input class="input" id="password" name="password" type="password" required placeholder="••••••••" />
            </div>
            <button class="btn primary block lg" type="submit">Sign in</button>
        </form>
    </div>

    <p class="muted" style="text-align:center;margin-top:18px">New here? <a asp-controller="Account" asp-action="Register" style="color:var(--primary);font-weight:600">Create an account</a></p>

    <div class="card pad" style="margin-top:20px;background:var(--surface-2)">
        <div class="eyebrow" style="margin-bottom:8px">Demo accounts · password Password123!</div>
        <div class="muted" style="font-size:.85rem;line-height:1.8">
            admin@printhub.vn<br>owner.quickprint@printhub.vn<br>customer1@printhub.vn
        </div>
    </div>
</div>
