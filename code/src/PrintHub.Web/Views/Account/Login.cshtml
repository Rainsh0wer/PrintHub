@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="ph-logo" style="justify-content:center;color:var(--accent)"><span class="mk" style="background:var(--accent);color:#fff">◒</span> PrintHub</div>
            <h1 style="font-size:1.5rem;font-weight:900;margin-top:14px">Welcome back</h1>
            <p class="muted" style="font-size:13px">Sign in to your account.</p>
        </div>

        @if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-input" name="email" type="email" required autofocus value="@ViewBag.Email" placeholder="you@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="form-input" name="password" type="password" required placeholder="••••••••" />
            </div>
            <button class="btn-ph btn-block btn-lg" type="submit">Sign in</button>
        </form>

        <p class="text-center muted mt-3" style="font-size:13px">New here? <a asp-controller="Account" asp-action="Register" class="fw-bold">Create an account</a></p>

        <div class="mt-3 p-3" style="background:var(--ink-light);border-radius:var(--radius-sm)">
            <div class="fw-bold" style="font-size:12px;color:var(--accent)">DEMO ACCOUNTS · password Password123!</div>
            <div class="muted" style="font-size:12.5px;line-height:1.9">admin@printhub.vn<br>owner.quickprint@printhub.vn<br>customer1@printhub.vn</div>
        </div>
    </div>
</div>
