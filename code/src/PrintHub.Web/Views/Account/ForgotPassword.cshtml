@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="ph-logo" style="justify-content:center;color:var(--accent)"><span class="mk" style="background:var(--accent);color:#fff">◒</span> PrintHub</div>
            <h1 style="font-size:1.5rem;font-weight:900;margin-top:14px">Reset your password</h1>
            <p class="muted" style="font-size:13px">Enter your email and we'll generate a reset link.</p>
        </div>

        @if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

        @if (ViewBag.Message != null)
        {
            <div class="alert-ph alert-ok mb-3">@ViewBag.Message</div>
            @if (ViewBag.DevToken != null)
            {
                <div class="alert-ph alert-info mb-3" style="font-size:12.5px">
                    <strong>Dev build:</strong> the reset link is shown here instead of being emailed.
                    <a class="fw-bold d-block mt-2" asp-action="ResetPassword" asp-route-email="@ViewBag.Email" asp-route-token="@ViewBag.DevToken">Reset my password now →</a>
                </div>
            }
            <p class="text-center muted mt-2" style="font-size:13px"><a asp-action="Login" class="fw-bold">Back to sign in</a></p>
        }
        else
        {
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-input" name="email" type="email" required autofocus value="@ViewBag.Email" placeholder="you@example.com" />
                </div>
                <button class="btn-ph btn-block btn-lg" type="submit">Send reset link</button>
            </form>
            <p class="text-center muted mt-3" style="font-size:13px">Remembered it? <a asp-action="Login" class="fw-bold">Sign in</a></p>
        }
    </div>
</div>
