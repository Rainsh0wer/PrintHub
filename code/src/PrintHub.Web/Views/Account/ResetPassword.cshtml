@{
    ViewData["Title"] = "Set a new password";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="ph-logo" style="justify-content:center;color:var(--accent)"><span class="mk" style="background:var(--accent);color:#fff">◒</span> PrintHub</div>
            <h1 style="font-size:1.5rem;font-weight:900;margin-top:14px">Set a new password</h1>
            <p class="muted" style="font-size:13px">Choose a strong password for your account.</p>
        </div>

        @if (ViewBag.Error != null) { <div class="alert-ph alert-err mb-3">@ViewBag.Error</div> }

        <form method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-input" name="email" type="email" required value="@ViewBag.Email" readonly="@(ViewBag.Email != null)" placeholder="you@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">New password</label>
                <input class="form-input" name="newPassword" type="password" required autofocus placeholder="••••••••" />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm new password</label>
                <input class="form-input" name="confirmPassword" type="password" required placeholder="••••••••" />
            </div>
            <button class="btn-ph btn-block btn-lg" type="submit">Reset password</button>
        </form>

        <p class="text-center muted mt-3" style="font-size:13px"><a asp-action="Login" class="fw-bold">Back to sign in</a></p>
    </div>
</div>
